# Development stack — copy to .env alongside docker-compose.yml on the Plesk server.
# Suggested Plesk stack name: bsk-development
# Domains: www.dev.example.com (storefront), api.dev.example.com (Vendure)

# ── Stack identity ────────────────────────────────────────────────────────────
STACK_ENV=development
ENV_FILE=.env
APP_ENV=production

# Root domain — ENV_LABEL inserts a segment before the root domain:
#   www.dev.example.com, api.dev.example.com
#
# Optional: set DEV_ROOT_DOMAIN in GitHub Actions variables to use a separate
# dev domain (e.g. staging.example.com) instead of www.dev.example.com.
# If unset, dev uses ENV_LABEL=dev. with the same ROOT_DOMAIN as production.
ROOT_DOMAIN=example.com
ENV_LABEL=dev.

# ── GHCR images ───────────────────────────────────────────────────────────────
# dev tag is published from the develop branch (see .github/workflows/docker-publish.yml)
GHCR_IMAGE_VENDURE=ghcr.io/solstis86/bsk/vendure
GHCR_IMAGE_STOREFRONT=ghcr.io/solstis86/bsk/storefront
IMAGE_TAG=dev

# Pin to a specific build for testing, e.g. IMAGE_TAG=sha-a1b2c3d

# ── Host ports (must not clash with production stack or other containers) ──────
VENDURE_HOST_PORT=3020
STOREFRONT_HOST_PORT=3021

# Only used when COMPOSE_PROFILES=container-db (bundled Postgres)
POSTGRES_HOST_PORT=6553

# Internal container ports
VENDURE_PORT=3000
STOREFRONT_PORT=3001
PORT=3000

# ── Database (separate from production) ───────────────────────────────────────
# Option A (default): Postgres already running on the Plesk host
DB_HOST=host.docker.internal
DB_PORT=5432

# Option B: bundled Postgres container — uncomment the next line and set DB_HOST=postgres
# COMPOSE_PROFILES=container-db
# DB_HOST=postgres
# DB_PORT=5432

DB_NAME=bsk_dev
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ── Vendure auth (use different secrets from production) ──────────────────────
COOKIE_SECRET=change-me-dev
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# ── Storefront / integrations ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
REVALIDATION_SECRET=change-me-dev

# Recommended for dev: disable scheduled feed imports
PRODUCT_FEED_SCHEDULE_ENABLED=false
STOCK_FEED_SCHEDULE_ENABLED=false
