# Production stack — copy to .env in THIS directory on the Plesk server:
#   deploy/production/.env
#
# Plesk stack compose file: deploy/production/docker-compose.yml
# Suggested stack name: bsk-production
#
# If a secret contains $ characters, escape them for Compose: use $$ for a literal $

# ── Stack identity ────────────────────────────────────────────────────────────
STACK_ENV=production
APP_ENV=production

# Root domain — public URLs are built as:
#   storefront  → https://${ENV_LABEL}${ROOT_DOMAIN}
#   vendure api → https://api.${ENV_LABEL}${ROOT_DOMAIN}
#
# Must match GitHub environment "production" variables:
#   ROOT_DOMAIN=buysomeknickers.com
#   ENV_LABEL=          (leave empty)
ROOT_DOMAIN=buysomeknickers.com
ENV_LABEL=

# ── GHCR images ───────────────────────────────────────────────────────────────
# prod tag is published from the main branch (see .github/workflows/docker-publish.yml)
GHCR_IMAGE_VENDURE=ghcr.io/solstis86/bsk/vendure
GHCR_IMAGE_STOREFRONT=ghcr.io/solstis86/bsk/storefront
IMAGE_TAG=prod

# Pin to a specific build for rollback, e.g. IMAGE_TAG=sha-a1b2c3d

# ── Host ports (must not clash with development stack or other containers) ────
VENDURE_HOST_PORT=3010
STOREFRONT_HOST_PORT=3011

# Only used when COMPOSE_PROFILES=container-db (bundled Postgres)
POSTGRES_HOST_PORT=6543

# Internal container ports (fixed; do not change unless you remap in compose)
VENDURE_PORT=3000
STOREFRONT_PORT=3001
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Option A (default): Postgres already running on the Plesk host
DB_HOST=host.docker.internal
DB_PORT=5432

# Option B: bundled Postgres container — uncomment the next line and set DB_HOST=postgres
# COMPOSE_PROFILES=container-db
# DB_HOST=postgres
# DB_PORT=5432

DB_NAME=bsk_prod
DB_SCHEMA=public
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ── Vendure auth ──────────────────────────────────────────────────────────────
COOKIE_SECRET=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me

# ── Storefront / integrations ─────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
REVALIDATION_SECRET=change-me

# Optional: disable scheduled imports on production until ready
# PRODUCT_FEED_SCHEDULE_ENABLED=true
# STOCK_FEED_SCHEDULE_ENABLED=true
